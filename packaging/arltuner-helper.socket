# arltuner root helper: the socket the GUI connects to (D-043). Socket activation: systemd owns this socket and starts
# arltuner-helper.service on the first connect; the helper exits again after ~10 idle minutes (idle_exit_s in /etc/arltuner/helper.toml).
# Access has two fences: the file mode below (only root and group arltuner can connect), and the helper's own SO_PEERCRED check of every
# connection against [access] in /etc/arltuner/helper.toml (a user listed there is admitted; root only if listed by name).
[Unit]
Description=arrowlake-tuner helper socket
Documentation=https://github.com/xyehya/arrowlake-tuner

[Socket]
ListenStream=/run/arltuner/helper.sock
SocketUser=root
SocketGroup=arltuner
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no

[Install]
WantedBy=sockets.target
