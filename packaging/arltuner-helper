#!/usr/bin/python3 -I
# arltuner root helper launcher (G-106, D-043). Installed to /usr/lib/arltuner/arltuner-helper, root-owned, mode 0755; it is the ExecStart of
# arltuner-helper.service (systemd socket activation): /usr/bin/python3 -I /usr/lib/arltuner/arltuner-helper --device --socket
# `-I` (isolated: no PYTHONPATH/user site, and no script directory or cwd on sys.path) so the only code that can be imported is the installed,
# root-owned tree added below. The helper itself refuses to start as root unless that whole tree passes the SPEC 4.4 trust check, and as root it
# accepts no argv but --device, or --device --socket (D-029, D-043).
import sys

sys.dont_write_bytecode = True  # the tree is precompiled at install time; root never writes into it afterwards
sys.path.insert(0, "/usr/lib/arltuner")

from arltuner.helper.main import process_main  # noqa: E402

process_main()
