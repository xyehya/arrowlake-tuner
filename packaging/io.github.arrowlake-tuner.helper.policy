<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!-- arltuner root helper (SPEC 4.1, G-106). pkexec matches this action on exec.path, so the GUI must start exactly
       pkexec /usr/lib/arltuner/arltuner-helper plus the single device flag (an XML comment cannot hold two hyphens in a row).
     The helper accepts no other argv as root (D-029). Every default is auth_admin: a password per start, no _keep, never allow_active=yes. -->
<policyconfig>
  <vendor>arrowlake-tuner</vendor>
  <vendor_url>https://github.com/xyehya/arrowlake-tuner</vendor_url>
  <action id="io.github.arrowlake-tuner.helper">
    <description>Run the arrowlake-tuner root helper</description>
    <message>Authentication is required to run the arrowlake-tuner helper (CPU telemetry and guarded tuning writes)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/arltuner/arltuner-helper</annotate>
  </action>
</policyconfig>
