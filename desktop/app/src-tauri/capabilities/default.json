{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core window/event defaults and the app's own commands only. No shell, fs or http plugins.",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-version",
    "allow-helper-status",
    "allow-helper-connect",
    "allow-helper-call",
    "allow-settings-get",
    "allow-settings-set",
    "allow-notify"
  ]
}
